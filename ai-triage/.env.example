# Copy to .env (never commit it) and fill in. All variables: see README.md.

# --- LLM provider: anthropic | openai | ollama | mock (offline heuristic, no LLM) ---
TRIAGE_LLM_PROVIDER=mock
# Exact model identifier offered by your provider. Required for anthropic/openai/ollama.
# Pin a specific, versioned model; do not rely on moving aliases (OWASP LLM03).
TRIAGE_LLM_MODEL=
# Only for the selected provider:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional endpoint override (OpenAI-compatible server, proxy, or Ollama URL):
# TRIAGE_LLM_BASE_URL=http://ollama:11434

# --- Inbound authentication (required, >= 16 chars). Generate: openssl rand -hex 32 ---
# The same value goes into <api_key> of the Wazuh <integration> block.
TRIAGE_API_TOKEN=

# --- Audit trail integrity key (recommended). Generate: openssl rand -hex 32 ---
TRIAGE_AUDIT_HMAC_KEY=

# --- Limits (OWASP LLM10) ---
TRIAGE_LLM_MAX_INPUT_TOKENS=6000
TRIAGE_LLM_MAX_OUTPUT_TOKENS=1024
TRIAGE_TOKEN_BUDGET_PER_MINUTE=150000
TRIAGE_RATE_LIMIT_PER_MINUTE=120
TRIAGE_LLM_MAX_CONCURRENCY=4

# --- Policy ---
# flag: hardened prompt + strict guardrails; block: suspicious alerts never reach the LLM
TRIAGE_INJECTION_POLICY=flag
TRIAGE_SEVERITY_MAX_DOWNGRADE=1
TRIAGE_OUTPUT_LANGUAGE=en
TRIAGE_PII_REHYDRATE_OUTPUT=true
