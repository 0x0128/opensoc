# OpenSOC configuration template.
#
# install.sh copies this file to infra/.env (mode 600, git-ignored) and replaces:
#   __GENERATE:<kind>__  with a random value (password, alnumN, hexN, uuid)
#   host-specific values (OPENSOC_HOSTNAME, SURICATA_INTERFACE, DOCKER_GID, CORTEX_JOB_DIR)
#     with values detected on the host.
# Keys added here later are appended to an existing .env on the next ./install.sh run;
# existing values are never overwritten. Never commit infra/.env.
#
# This template is also what CI uses to validate docker-compose.yml.

# ---------------------------------------------------------------- Host
# Name or IP used in the URLs and in the TLS certificate of the web UIs.
OPENSOC_HOSTNAME=opensoc.local
# Address the published ports bind to (0.0.0.0 = all interfaces).
OPENSOC_BIND_ADDRESS=0.0.0.0
OPENSOC_TZ=UTC
# NIC monitored by Suricata (default: interface of the default route).
SURICATA_INTERFACE=eth0
# GID of /var/run/docker.sock (lets Cortex start analyzer containers).
DOCKER_GID=999
# Host directory for Cortex jobs (must be an absolute path).
CORTEX_JOB_DIR=/opt/opensoc/infra/data/cortex-jobs
# Open-files limit of the indexers, Elasticsearch and the Wazuh manager.
OPENSOC_NOFILE=65536

# ---------------------------------------------------------------- Published ports
WAZUH_DASHBOARD_PORT=443
WAZUH_API_PORT=55000
WAZUH_INDEXER_PORT=9200
THEHIVE_PORT=9000
CORTEX_PORT=9001
MISP_PORT=8443
SHUFFLE_PORT=3443
GRAFANA_PORT=3000

# ---------------------------------------------------------------- Memory (16 GB host profile)
WAZUH_INDEXER_HEAP=1g
WAZUH_INDEXER_MEM_LIMIT=2g
WAZUH_MANAGER_MEM_LIMIT=1536m
WAZUH_DASHBOARD_MEM_LIMIT=1g
SURICATA_MEM_LIMIT=1g
CASSANDRA_HEAP=1G
CASSANDRA_MEM_LIMIT=2g
ELASTICSEARCH_HEAP=768m
ELASTICSEARCH_MEM_LIMIT=1536m
THEHIVE_HEAP=1g
THEHIVE_MEM_LIMIT=2g
CORTEX_HEAP=512m
CORTEX_MEM_LIMIT=1g
MISP_MEM_LIMIT=1536m
MISP_DB_BUFFER_POOL=256M
MISP_DB_MEM_LIMIT=768m
MISP_REDIS_MEM_LIMIT=256m
MISP_MODULES_MEM_LIMIT=512m
SHUFFLE_OPENSEARCH_HEAP=512m
SHUFFLE_OPENSEARCH_MEM_LIMIT=1280m
SHUFFLE_BACKEND_MEM_LIMIT=768m
GRAFANA_MEM_LIMIT=1g

# ---------------------------------------------------------------- Wazuh
WAZUH_INDEXER_PASSWORD=__GENERATE:password__
WAZUH_DASHBOARD_PASSWORD=__GENERATE:password__
WAZUH_API_PASSWORD=__GENERATE:password__
# Password agents must present to enroll (agent: WAZUH_REGISTRATION_PASSWORD).
WAZUH_ENROLLMENT_PASSWORD=__GENERATE:alnum32__
WAZUH_CLUSTER_KEY=__GENERATE:hex32__
# Vulnerability detection (yes/no). The CVE feed needs ~15 GB of extra disk on first start.
WAZUH_VULNERABILITY_DETECTION=yes
# Read-only indexer account used by Grafana.
GRAFANA_INDEXER_PASSWORD=__GENERATE:password__

# ---------------------------------------------------------------- Suricata
SURICATA_UPDATE_INTERVAL=86400
SURICATA_EVE_MAX_MB=512

# ---------------------------------------------------------------- TheHive + Cortex
THEHIVE_ORG=OpenSOC
THEHIVE_SECRET=__GENERATE:alnum64__
THEHIVE_ADMIN_PASSWORD=__GENERATE:password__
THEHIVE_ANALYST_PASSWORD=__GENERATE:password__
# Wazuh alerts with level >= THEHIVE_ALERT_LEVEL are sent to TheHive;
# level >= THEHIVE_CASE_LEVEL are promoted to cases.
THEHIVE_ALERT_LEVEL=10
THEHIVE_CASE_LEVEL=12
# Filled in by install.sh (generated by TheHive / Cortex).
THEHIVE_INTEGRATION_API_KEY=
CORTEX_API_KEY=
ELASTIC_PASSWORD=__GENERATE:password__
CORTEX_SECRET=__GENERATE:alnum64__
CORTEX_ADMIN_PASSWORD=__GENERATE:password__

# ---------------------------------------------------------------- MISP
MISP_ORG=OpenSOC
MISP_EMAIL=misp@opensoc.local
MISP_ADMIN_EMAIL=admin@opensoc.local
MISP_ADMIN_PASSWORD=__GENERATE:password__
MISP_ADMIN_KEY=__GENERATE:alnum40__
# API key of automation@opensoc.local (used by misp-ioc-sync and Shuffle).
MISP_AUTOMATION_KEY=__GENERATE:alnum40__
MISP_UUID=__GENERATE:uuid__
MISP_SALT=__GENERATE:alnum48__
MISP_ENCRYPTION_KEY=__GENERATE:alnum48__
MISP_DB_PASSWORD=__GENERATE:password__
MISP_DB_ROOT_PASSWORD=__GENERATE:password__
MISP_REDIS_PASSWORD=__GENERATE:alnum32__
# MISP -> Wazuh IOC export: interval (s) and maximum attribute age (MISP relative time).
MISP_SYNC_INTERVAL=300
MISP_IOC_MAX_AGE=90d

# ---------------------------------------------------------------- Shuffle
SHUFFLE_ADMIN_USER=admin
SHUFFLE_ADMIN_PASSWORD=__GENERATE:password__
SHUFFLE_API_KEY=__GENERATE:uuid__
SHUFFLE_ENCRYPTION_MODIFIER=__GENERATE:alnum32__
# ID of the webhook of the example playbook (also its secret URL path).
SHUFFLE_WEBHOOK_ID=__GENERATE:uuid__

# ---------------------------------------------------------------- Grafana
GRAFANA_ADMIN_PASSWORD=__GENERATE:password__
