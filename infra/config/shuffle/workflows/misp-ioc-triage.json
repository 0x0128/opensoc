        { "name": "headers", "value": "Authorization: Bearer __THEHIVE_API_KEY__\nContent-Type: application/json\nX-Organisation: __THEHIVE_ORG__", "multiline": true },
        { "name": "body", "value": "{\"type\": \"misp-sighting\", \"source\": \"shuffle\", \"sourceRef\": \"wazuh-$exec.id\", \"title\": \"[Shuffle] $exec.title\", \"severity\": 3, \"tlp\": 2, \"pap\": 2, \"tags\": [\"shuffle\", \"misp\", \"wazuh:rule=$exec.rule_id\", \"opensoc:playbook=misp-ioc-triage\"], \"description\": \"Wazuh alert `$exec.id` (rule $exec.rule_id) matched an indicator published in MISP.\\n\\n- MISP event: #$misp_lookup.body.response.Attribute.#0.event_id - $misp_lookup.body.response.Attribute.#0.Event.info\\n- Indicator: $misp_lookup.body.response.Attribute.#0.type $misp_lookup.body.response.Attribute.#0.value (category $misp_lookup.body.response.Attribute.#0.category)\\n- MISP sighting recorded: HTTP $misp_sighting.status\\n- Wazuh agent: $exec.all_fields.agent.name\\n- Suricata signature: $exec.all_fields.data.alert.signature\", \"observables\": [{\"dataType\": \"ip\", \"data\": \"$exec.all_fields.data.src_ip\", \"message\": \"Source IP\", \"tags\": [\"misp\"]}, {\"dataType\": \"ip\", \"data\": \"$exec.all_fields.data.dest_ip\", \"message\": \"Destination IP\", \"tags\": [\"misp\"]}]}", "multiline": true },
        { "name": "username", "value": "" },
        { "name": "password", "value": "" },
        { "name": "verify", "value": "false" },
        { "name": "http_proxy", "value": "" },
        { "name": "https_proxy", "value": "" },
        { "name": "timeout", "value": "30" },
        { "name": "to_file", "value": "false" }
