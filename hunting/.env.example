# Copy this file to .env (ignored by git) and load it with: set -a; . ./.env; set +a

# --- Wazuh Indexer (OpenSearch) ---
WAZUH_INDEXER_URL=https://wazuh-indexer.lab.local:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=change-me
# Path to the lab CA (recommended) or WAZUH_INDEXER_INSECURE=1 for self-signed certificates
WAZUH_INDEXER_CA=/etc/opensoc/root-ca.pem
# WAZUH_INDEXER_INSECURE=1
# WAZUH_INDEXER_INDEX=wazuh-alerts-*
# WAZUH_INDEXER_TIME_FIELD=timestamp

# --- Emulation ---
# Comma-separated list of lab hosts on which Atomic Red Team is allowed to run
OPENSOC_LAB_TARGETS=win10-lab,ubuntu-lab

# --- MISP ---
MISP_URL=https://misp.lab.local
MISP_KEY=your-misp-api-key
MISP_CA_BUNDLE=/etc/opensoc/root-ca.pem
# MISP_INSECURE=1
